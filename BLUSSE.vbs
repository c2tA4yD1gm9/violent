Function IsAdmin()
    IsAdmin = (objShell.Run("cmd /c net session >nul 2>&1", 0, True) = 0)
End Function

Function GetCurrentPID()
    Dim oWMI, oProcs, oProc
    Set oWMI = GetObject("winmgmts:\\.\root\cimv2")
    Set oProcs = oWMI.ExecQuery("SELECT ProcessId, CommandLine FROM Win32_Process WHERE Name='wscript.exe'")
    GetCurrentPID = 0
    For Each oProc In oProcs
        If InStr(oProc.CommandLine, WScript.ScriptName) > 0 And InStr(oProc.CommandLine, "KILLPARENT") = 0 Then
            GetCurrentPID = oProc.ProcessId
            Exit For
        End If
    Next
End Function

